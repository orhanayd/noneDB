# Text is LF on every platform (tools/build.php refuses CR)
* text=auto eol=lf

# noneDB.php is built from src/ by tools/build.php; packages ship only the built files
/src export-ignore
/migrate export-ignore
/tools export-ignore
/tests export-ignore
/docs export-ignore
/examples export-ignore
/build export-ignore
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/phpunit.xml export-ignore
/CHANGES.md export-ignore
noneDB.php linguist-generated=true
