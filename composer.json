{
    "name": "orhanayd/nonedb",
    "description": "File-based NoSQL database for PHP - No installation required",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Orhan Aydogdu",
            "email": "info@orhanaydogdu.com.tr",
            "homepage": "https://www.orhanaydogdu.com.tr"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "rakibtg/sleekdb": "^2.15"
    },
    "autoload": {
        "classmap": ["noneDB.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "noneDB\\Tests\\": "tests/"
        }
    },
    "bin": ["noneDB-migrate.php"],
    "scripts": {
        "build": "@php tools/build.php",
        "test": [
            "@php tools/build.php --check",
            "phpunit"
        ],
        "test-verbose": "phpunit --testdox"
    },
    "config": {
        "sort-packages": true
    }
}
